# ==============================================================================
# TRIBE-local Environment Configuration
# Copy this file to .env:  cp .env.example .env
# DO NOT commit .env containing real secrets to version control!
# ==============================================================================

# DeepSeek API Key (Required for DeepSeek text embeddings)
# Sign up and obtain key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Cache directory override (defaults to ~/.tribe_cache)
TRIBE_CACHE_DIR=~/.tribe_cache
